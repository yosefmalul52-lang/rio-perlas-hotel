# CloudLogin / Exclusive Hosting SMTP (server-side only — never expose to Vite)
SMTP_HOST=mail.exclusivehosting.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rioperlasresort.com
SMTP_PASSWORD=
CONTACT_TO_EMAIL=info@rioperlasresort.com
SMTP_FROM_NAME=Rio Perlas Resort
SMTP_FROM_EMAIL=info@rioperlasresort.com

# Optional: forward a copy of accepted inquiries to a CRM/webhook (after SMTP succeeds)
# INQUIRY_WEBHOOK_URL=

# Optional: protect POST /api/inquiries/verify-smtp in local/dev
# SMTP_VERIFY_TOKEN=
# ALLOW_SMTP_VERIFY=true
